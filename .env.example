# Local configuration template.
# To start locally: cp .env.example .env && chmod 600 .env
# In Railway: do not use this file; set these as Service Variables instead.

# Telegram Bot Token from @BotFather (format: 123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ)
# Required for running the bot.
TELEGRAM_BOT_TOKEN=

# Telegram User ID of the bot owner from @userinfobot (numbers only)
# Required for running the bot.
OWNER_ID=

# Operating mode: false = PREVIEW (replies only logged), true = AUTO_SEND (sends replies)
AUTO_SEND=false

# Long-lived Claude Code subscription token (starts with sk-ant-oat...)
# Run 'claude setup-token' in your browser-enabled terminal, authenticate, and paste the token here.
# Paste using a text editor on a SINGLE line (do NOT use 'echo' to avoid saving to shell history).
# Valid for 1 year. If left empty, the local 'claude' CLI login on this machine will be used.
CLAUDE_CODE_OAUTH_TOKEN=

# Path to claude binary. Leave empty to auto-detect from PATH or ~/.local/bin/claude
CLAUDE_BIN=

# Claude model name (e.g. claude-sonnet-4-5-20250929). Leave empty for CLI default
CLAUDE_MODEL=

# Effort level for reasoning: low, medium, high, xhigh, max
CLAUDE_EFFORT=low

# Subprocess timeout in seconds (minimum: 1)
CLAUDE_TIMEOUT_SECONDS=120

# Usage limit cooldown in minutes when limit reset time is unknown (minimum: 1)
LIMIT_COOLDOWN_MINUTES=30

# Silence assistant for N minutes after the owner sends a message in a chat (0 = disabled)
OWNER_TAKEOVER_MINUTES=15

# Maximum conversation history items to retain per chat (minimum: 1)
HISTORY_LIMIT=30

# AI Provider: 'gemini' or 'claude'. If GEMINI_API_KEY is provided, defaults to 'gemini'.
AI_PROVIDER=gemini

# Google Gemini API key from https://aistudio.google.com/
# Free to use, fast, and does not require Claude subscription.
GEMINI_API_KEY=

# Gemini model: gemini-3.1-flash-lite, gemini-2.5-pro, gemini-3.8-flash
GEMINI_MODEL=gemini-3.1-flash-lite
